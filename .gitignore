**/.DS_Store

CMakeFiles/*

# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
builds/*
build/*

# The wasm module the web frontend loads, staged there by build_web.py --frontend.
# It's a 21 MB build artifact, so it's produced rather than committed; the page falls back to the
# mocks (and js/mock_data.js, which IS committed) when it isn't there.
web/wasm/*

# The page's third party, fetched and hash checked by build_web.py --vendor (pinned in its VENDOR table).
web/vendor/

# Precompressed siblings for the page's own files, written by build_web.py --precompress.
web/**/*.br
web/**/*.gz

# jsdom, which web/dev/smoke.js asks for with `npm i jsdom` (see web/README.md).
web/node_modules/
.vs/*
CMakeUserPresets.json
compile_commands.json
tools/builds/*
tools/CMakeFiles/*
*.vcxproj
*.filters
*.sln
*.stamp
*.depend
tools/bin/*
tools/CMakeCache.txt
tools/*.cmake
inc/cfg/*
modules.order
Module.symvers
Mkfile.old
dkms.conf
inc/cfg/config.h
.dep_hashes.json
__pycache__/
# Local dependency clones for inspection (fetched via conan in CI, not committed)
/radeon_gpu_analyzer/
/nvapi/
/DirectXShaderCompiler/
