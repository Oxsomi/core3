**/.DS_Store

CMakeFiles/*

# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# A mesh reader's test corpus IS .obj files, so the rule above has to make room for them; without this a
# fixture is invisible to git and the suite passes locally while failing for everyone else.

!src/formats/obj/test/*.obj

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
builds/*
build/*
.vs/*
CMakeUserPresets.json
compile_commands.json
tools/builds/*
tools/CMakeFiles/*
*.vcxproj
*.filters
*.sln
*.stamp
*.depend
tools/bin/*
tools/CMakeCache.txt
tools/*.cmake
inc/cfg/*
modules.order
Module.symvers
Mkfile.old
dkms.conf
inc/cfg/config.h
.dep_hashes.json
__pycache__/
# Local dependency clones for inspection (fetched via conan in CI, not committed)
/radeon_gpu_analyzer/
/nvapi/
/DirectXShaderCompiler/
